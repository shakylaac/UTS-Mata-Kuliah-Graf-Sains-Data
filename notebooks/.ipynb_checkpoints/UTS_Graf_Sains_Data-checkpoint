   "source": [
    "from sklearn.preprocessing import normalize\n",
    "\n",
    "visitor_vsm = normalize(visitor_item_matrix, norm=\"l2\", axis=1)\n",
    "\n",
    "print(\"Shape Visitor VSM:\", visitor_vsm.shape)\n",
    "print(\"Jumlah nilai non-zero:\", visitor_vsm.nnz)"
